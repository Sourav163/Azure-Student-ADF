				"typeProperties": {
					"source": {
						"type": "AzureMySqlSource",
						"query": "-- Step 1: get the row count into a variable\nSET @cnt = (SELECT COUNT(*) FROM sourav_db.cricket_players);\n\n-- Step 2: decide batch size based on count\nSET @batch_size = CASE \n    WHEN @cnt >= 10001 THEN 10000\n    WHEN @cnt BETWEEN 1001 AND 10000 THEN 1000\n    WHEN @cnt BETWEEN 101 AND 1000 THEN 100\n    ELSE 10\nEND;\n\n-- Step 3: main query\nSELECT\n    CAST(ROW_NUMBER() OVER (ORDER BY player_id) AS CHAR) AS sno,\n    CAST(CEIL(ROW_NUMBER() OVER (ORDER BY player_id) / @batch_size) AS CHAR) AS batch_nm,\n    player_id,\n    0 AS is_process\nFROM sourav_db.cricket_players\nORDER BY player_id;",
						"queryTimeout": "02:00:00"
					},
					"dataset": {
						"referenceName": "ds_mysql_tb_dyn",
						"type": "DatasetReference",
						"parameters": {
