						"writeBatchTimeout": "00:00:30",
						"preCopyScript": "CREATE TABLE `cricket_players` (\n  `player_id` int NOT NULL AUTO_INCREMENT,\n  `first_name` varchar(50) DEFAULT NULL,\n  `last_name` varchar(50) DEFAULT NULL,\n  `country` varchar(50) DEFAULT NULL,\n  `birth_date` date DEFAULT NULL,\n  `age` int DEFAULT NULL,\n  `batting_style` varchar(30) DEFAULT NULL,\n  `bowling_style` varchar(30) DEFAULT NULL,\n  `role` varchar(30) DEFAULT NULL,\n  `matches_played` int DEFAULT NULL,\n  `innings_batted` int DEFAULT NULL,\n  `runs_scored` int DEFAULT NULL,\n  `highest_score` int DEFAULT NULL,\n  `batting_average` decimal(5,2) DEFAULT NULL,\n  `balls_bowled` int DEFAULT NULL,\n  `wickets_taken` int DEFAULT NULL,\n  `bowling_average` decimal(5,2) DEFAULT NULL,\n  `economy_rate` decimal(4,2) DEFAULT NULL,\n  `catches` int DEFAULT NULL,\n  `stumpings` int DEFAULT NULL,\n  `debut_date` date DEFAULT NULL,\n  `last_match_date` date DEFAULT NULL,\n  `is_active` tinyint(1) DEFAULT NULL,\n  `team` varchar(50) DEFAULT NULL,\n  `jersey_number` int DEFAULT NULL,\n  `height_cm` int DEFAULT NULL,\n  `weight_kg` int DEFAULT NULL,\n  `dominant_hand` varchar(10) DEFAULT NULL,\n  `nickname` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`player_id`)\n) ENGINE=InnoDB AUTO_INCREMENT=63 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;\n"
					},
